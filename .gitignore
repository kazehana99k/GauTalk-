# --- datasets ---
data/*
!*.gitkeep

# --- shell redirect junk (argparse flags treated as filenames) ---
--*
/-s

# --- root-level docs/notes: ignore all by default, whitelist below ---
/*.md
/*.txt
/*.bak
/*.bak_*

# whitelist the docs we DO want to track
!/README.md
!/README_en.md
!/PROJECT_HISTORY.md
!/CLAUDE.md
!/LICENSE.md

