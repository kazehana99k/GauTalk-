# --- python / build ---
__pycache__/
*.pyc
build/
*.egg-info/
*.so
gridencoder/gridencoder.egg-info
diff_rasterization/diff_rast.egg-info
diff_rasterization/dist

# --- media / weights ---
*.mp4
*.pth
*.pth.[0-9]
*.npy
*.npz

# --- editor / IDE / dotfiles ---
.vscode
.idea/
.claude/
.cursor/
.session-*
.all-sessions-*
.placeholder

# --- pre-trained model assets ---
data_utils/face_tracking/3DMM/*
